# Copy to .env and edit.  (`./4231.sh` creates it for you on first run.)

# Folder bind-mounted at ~/4231 in the container. Default: this repository.
CODE_DIR=..

# Match your host user so files built in the container are owned by you (Linux)
HOST_UID=1000
HOST_GID=1000

# UR5e controller IP (setupRealur5e.sh uses 192.168.0.100)
ROBOT_IP=192.168.0.100

# This computer's IP on the robot network (e.g. 192.168.0.10).
#   macOS: REQUIRED for the real robot — also enter it as "Host IP" in the
#          External Control URCap on the pendant.
#   Linux: leave empty (auto-detected with host networking).
HOST_IP=

# Give every bench a different value (0-101) so labs on a shared network
# don't see each other's ROS topics.
ROS_DOMAIN_ID=0

# Password for the desktop when using a native VNC client (macOS Screen
# Sharing: vnc://localhost:5901). Leave empty for the browser desktop only.
VNC_PASSWORD=
